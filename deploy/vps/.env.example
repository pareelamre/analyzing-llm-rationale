# Foresea on a single VPS -- environment template.
#
#   cp .env.example .env && chmod 600 .env
#
# Pull the secret values out of GCP Secret Manager once, then delete them from
# GCP after cutover:
#
#   for s in SCADS_AI_API_KEY GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET \
#            GITHUB_CLIENT_ID GITHUB_CLIENT_SECRET SESSION_SECRET \
#            GOOGLE_WEATHER_API_KEY SERPER_API_KEY TAVILY_API_KEY \
#            FRED_API_KEY PREDICT_API_KEY; do
#     echo "$s=$(gcloud secrets versions access latest --secret=$s \
#           --project=brave-drive-471109-d9)"
#   done >> .env

# ── Required: LLM provider ───────────────────────────────────────────────────
# NOTE: server.py reads SCADS_AI_API_KEY. The historical name SCADS_API_KEY is
# only honoured by cli.py, so using it here leaves /ready at 503.
SCADS_AI_API_KEY=

# ── Required: sessions and OAuth ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Recommended: close the public analytics endpoints ────────────────────────
# Without API_KEY, /analytics/users returns registered accounts, their email
# addresses and last login to anyone. Set it.
API_KEY=
# Salts visitor hashes. Changing it resets cumulative unique-visitor counts.
ANALYTICS_SALT=

# ── Optional: research and market data ───────────────────────────────────────
GOOGLE_WEATHER_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
FRED_API_KEY=
PREDICT_API_KEY=

# ── App behaviour (mirrors the Cloud Run env) ────────────────────────────────
CUSTOM_DOMAIN=foresea.ink
INTERACTIVE_DEFAULT_MODEL=gemma-4-26b-a4b-it
INTERACTIVE_MAX_TOKENS=384
CHAT_PROVIDER_TIMEOUT_S=15
CHAT_PROVIDER_MAX_RETRIES=0
EVIDENCE_TIMEOUT_S=0
EVIDENCE_MAX_CONCURRENCY=4
FORESEA_ENABLE_BYO_TRADING=true

# ── Twin runtime (only if you are moving it too) ─────────────────────────────
# Shared between the dispatcher and the worker; generate with openssl rand -hex 32.
FORESEA_TWIN_DISPATCH_SECRET=
FORESEA_TWIN_MAINTENANCE_URL=http://app:8000
FORESEA_TWIN_RESEARCH_URL=http://app:8000

# ── Cron (only if you are moving the scheduler jobs) ─────────────────────────
# A GitHub token with actions:write, used to dispatch the tick workflows.
GH_DISPATCH_TOKEN=

# ── Dropped from the Cloud Run config ────────────────────────────────────────
# FORESEA_TRADING_KMS_KEY_NAME  -- Cloud KMS is GCP-only. model_providers.py
#                                  falls back to a Fernet key derived from
#                                  SESSION_SECRET, so keep that secret safe.
# MARKETD_URL                   -- pointed at a Cloud Run service; set it to
#                                  the local marketd container if you run one.
