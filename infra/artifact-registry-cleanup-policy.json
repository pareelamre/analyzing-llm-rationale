[
  {
    "name": "keep-recent-versions",
    "action": {"type": "Keep"},
    "mostRecentVersions": {
      "keepCount": 5
    }
  },
  {
    "name": "delete-old-untagged",
    "action": {"type": "Delete"},
    "condition": {
      "tagState": "UNTAGGED",
      "olderThan": "86400s"
    }
  },
  {
    "name": "delete-old-tagged-images",
    "action": {"type": "Delete"},
    "condition": {
      "tagState": "TAGGED",
      "olderThan": "604800s"
    }
  }
]
