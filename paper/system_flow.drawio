        <mxCell id="question" value="&lt;b&gt;Will SpaceX re-use a Starship booster before October 1, 2025?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Resolves Yes if a previously flown booster launches before 1 Oct 2025." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#20262e;strokeWidth=1.5;fontSize=17;fontColor=#111111;align=center;verticalAlign=middle;spacing=14;arcSize=6;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="240" y="162" width="370" height="156" as="geometry"/>
        </mxCell>
        <mxCell id="evidence" value="&lt;b&gt;Retrieved evidence&lt;/b&gt;&lt;br&gt;Space.com, Sep. 2025: Flight 11 (Oct 13) will re-fly the booster first flown on Flight 8 â€” and notes the earlier Flight 9 reuse (May 27).&lt;br&gt;&lt;br&gt;Other articles report only the upcoming Flight 11 reuse." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f3ee;strokeColor=#2f6f58;strokeWidth=1.4;fontSize=16;fontColor=#111111;align=center;verticalAlign=middle;spacing=12;arcSize=6;fontFamily=Helvetica;" parent="1" vertex="1">
