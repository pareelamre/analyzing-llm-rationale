        <mxCell id="study_label" value="4  Study-level evaluation" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#111111;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="240" y="554" width="350" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="study" value="&lt;b&gt;1,580 questions x 9 prompt conditions&lt;br&gt;x 3 models x 6 temperatures&lt;/b&gt;&lt;br&gt;&lt;br&gt;Primary: Brier score, log loss&lt;br&gt;Diagnostics: accuracy, ECE, validity, rationale quality" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#9b7a3d;strokeWidth=1.4;fontSize=17;fontColor=#111111;align=center;verticalAlign=middle;spacing=12;arcSize=6;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="240" y="592" width="370" height="146" as="geometry"/>
        </mxCell>
        <mxCell id="interpretation" value="&lt;b&gt;Interpretation&lt;/b&gt;&lt;br&gt;The discrete answer flips from No to Yes, and implied P(Yes) moves from 0.18 to 0.78â€“0.85. V0 anchors on the planned Flight 11 reuse and misses the Flight 9 reuse already in the evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#20262e;strokeWidth=1.4;fontSize=15;fontColor=#111111;align=center;verticalAlign=middle;spacing=12;arcSize=6;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="690" y="614" width="568" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="caption" value="Figure 1: Representative case from the forecasting study (Metaculus 29222; GPT-OSS-120B, T=0.75). Boxes reproduce the raw answer and the confidence in that answer, c(answer). For evaluation, No forecasts are converted using P(Yes) = 1 âˆ’ c(answer). Accuracy uses the discrete answer, whereas Brier score and log loss use the implied P(Yes). The example is illustrative; the paper's main claims are based on paired aggregate evaluation." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#444444;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="150" y="742" width="1200" height="60" as="geometry"/>
        </mxCell>

