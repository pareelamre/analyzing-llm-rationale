        <mxCell id="outcome_label" value="3  Forecasts for this case" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#111111;fontFamily=Helvetica;" parent="1" vertex="1">
