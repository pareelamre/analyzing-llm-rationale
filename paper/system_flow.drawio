        </mxCell>
        <mxCell id="o8" value="&lt;b&gt;Yes | c(answer)=0.85&lt;/b&gt;&lt;br&gt;P(Yes)=0.85" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f3ee;strokeColor=#2f6f58;strokeWidth=1.4;fontSize=15;fontColor=#111111;align=center;verticalAlign=middle;spacing=6;arcSize=6;fontFamily=Helvetica;" parent="1" vertex="1">
