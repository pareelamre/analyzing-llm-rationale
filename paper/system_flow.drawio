        <mxCell id="o0" value="&lt;b&gt;No | c(answer)=0.82&lt;/b&gt;&lt;br&gt;Implied P(Yes)=0.18" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#20262e;strokeWidth=1.4;fontSize=15;fontColor=#111111;align=center;verticalAlign=middle;spacing=6;arcSize=6;fontFamily=Helvetica;" parent="1" vertex="1">
