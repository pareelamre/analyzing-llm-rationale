  <diagram id="prob-temporal-inference" name="Probabilistic Reasoning and Temporal Inference">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="prob_box" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2563EB;strokeWidth=3;fillColor=#EFF6FF;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="100" width="1260" height="710" as="geometry" />
        </mxCell>
        <mxCell id="prior" value="Prior belief&lt;br&gt;&lt;b&gt;P(H)&lt;/b&gt; or &lt;b&gt;P(X&lt;sub&gt;0&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;background knowledge before new data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#1D4ED8;fillColor=#DBEAFE;fontSize=15;fontColor=#111827;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="190" width="210" height="105" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="Evidence / observations&lt;br&gt;&lt;b&gt;E&lt;sub&gt;1:t&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;new contextual and temporal data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#047857;fillColor=#D1FAE5;fontSize=15;fontColor=#111827;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="370" width="210" height="105" as="geometry" />
        </mxCell>
        <mxCell id="bayes" value="Bayesian update&lt;br&gt;&lt;b&gt;P(H|E) = P(E|H)P(H) / P(E)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;likelihood weights hypotheses by fit to evidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#7C3AED;fillColor=#F3E8FF;fontSize=15;fontColor=#111827;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="posterior" value="Posterior belief state&lt;br&gt;&lt;b&gt;P(X&lt;sub&gt;t&lt;/sub&gt; | E&lt;sub&gt;1:t&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;current uncertainty after all evidence so far&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#B45309;fillColor=#FEF3C7;fontSize=15;fontColor=#111827;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="280" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="forecast" value="Forecast / prediction&lt;br&gt;&lt;b&gt;P(X&lt;sub&gt;t+k&lt;/sub&gt; | E&lt;sub&gt;1:t&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;future event probability with calibrated uncertainty&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#BE123C;fillColor=#FFE4E6;fontSize=15;fontColor=#111827;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="280" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="temporal_box" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#0F766E;strokeWidth=3;fillColor=#F0FDFA;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="370" y="500" width="810" height="230" as="geometry" />
        </mxCell>
        <mxCell id="temporal_label" value="Temporal inference: probabilistic reasoning over time-indexed states and observations" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontStyle=1;fontColor=#0F766E;" vertex="1" parent="1">
          <mxGeometry x="395" y="515" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="state_tm1" value="State at &lt;b&gt;t-1&lt;/b&gt;&lt;br&gt;P(X&lt;sub&gt;t-1&lt;/sub&gt; | E&lt;sub&gt;1:t-1&lt;/sub&gt;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#0F766E;fillColor=#CCFBF1;fontSize=14;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="420" y="595" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="transition" value="Transition model&lt;br&gt;&lt;b&gt;P(X&lt;sub&gt;t&lt;/sub&gt; | X&lt;sub&gt;t-1&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;time dynamics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#0F766E;fillColor=#FFFFFF;fontSize=14;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="650" y="585" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="state_t" value="State at &lt;b&gt;t&lt;/b&gt;&lt;br&gt;P(X&lt;sub&gt;t&lt;/sub&gt; | E&lt;sub&gt;1:t&lt;/sub&gt;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#0F766E;fillColor=#CCFBF1;fontSize=14;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="890" y="595" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="obs_t" value="Observation at &lt;b&gt;t&lt;/b&gt;&lt;br&gt;E&lt;sub&gt;t&lt;/sub&gt; with likelihood&lt;br&gt;P(E&lt;sub&gt;t&lt;/sub&gt; | X&lt;sub&gt;t&lt;/sub&gt;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#047857;fillColor=#D1FAE5;fontSize=14;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="890" y="685" width="170" height="75" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Core idea: temporal inference is not separate from probabilistic reasoning; it is the dynamic case where beliefs are recursively propagated through time and corrected by new observations." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#4B5563;fillColor=#F9FAFB;fontSize=14;fontColor=#111827;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="760" width="1000" height="34" as="geometry" />
        </mxCell>
